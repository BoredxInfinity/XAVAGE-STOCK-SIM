SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# How often to pull fresh prices (seconds). 5 is a good live-event cadence.
POLL_INTERVAL_SECONDS=5

# Slow cadence used when the US market is closed (seconds).
IDLE_INTERVAL_SECONDS=120

# Intraday bar backfill cadence (seconds). Chart history, not live prices.
BAR_INTERVAL_SECONDS=300
