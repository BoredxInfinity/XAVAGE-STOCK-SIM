SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# How often to pull fresh prices (seconds). A full cycle over ~100 symbols
# takes about 4s, nearly all of it waiting on Yahoo, so 5 is about as tight as
# this usefully goes.
POLL_INTERVAL_SECONDS=5

# Slow cadence used when the US market is closed (seconds).
IDLE_INTERVAL_SECONDS=120

# Refresh cadence for the LONG chart ranges (5D/1Y) in seconds. The 1-minute
# series rides along with every price tick, so the chart is never staler than
# the price and this only covers deeper history.
HISTORY_INTERVAL_SECONDS=1800

# Ceiling on how many tradable instruments get quoted. Keep it above the size
# of your universe -- if it truncates, symbols silently have no price and
# orders on them are refused. The worker logs a warning when that happens.
MAX_SYMBOLS=400

# ---------------------------------------------------------------------------
# Tuning. The defaults are measured on a 105-symbol universe and a 1 OCPU /
# 1 GB Oracle instance; you should not need to touch these.
# ---------------------------------------------------------------------------

# Symbols per bulk download request.
BATCH_SIZE=60

# yfinance fetches one URL per symbol, so a cycle is bound by concurrency, not
# CPU. Measured: 4 threads 4.2s, 8 threads 3.7s, 24 threads 3.5s -- past 8 the
# gain is noise and the in-flight responses just cost memory.
DOWNLOAD_THREADS=8

# How many 1-minute bars to backfill per symbol on a cold start. After that the
# worker only sends bars the database has not seen, so this is a one-time cost.
BARS_PER_SYMBOL=500
