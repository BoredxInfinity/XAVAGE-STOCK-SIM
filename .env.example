# ---- Next.js app (Vercel: Project Settings > Environment Variables) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER expose to the browser. Used by admin routes + cron.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret for the Vercel cron fallback + the Python worker's admin RPCs.
CRON_SECRET=generate-a-long-random-string

# ---- Python worker (worker/.env) ----
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# POLL_INTERVAL_SECONDS=5

# Price transport: "broadcast" (default) or "postgres_changes".
# Broadcast is one batched message per cycle; Postgres Changes is one message
# per row per client, which is ~105x more and will exhaust the Realtime quota
# during a live event. The client falls back on its own if a broadcast
# subscription is refused, so this is only for forcing the old path.
NEXT_PUBLIC_QUOTES_TRANSPORT=broadcast
